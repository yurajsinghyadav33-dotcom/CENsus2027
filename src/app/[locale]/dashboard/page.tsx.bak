"use client";

import React from 'react';
import { useTranslations } from 'next-intl';
import dynamic from 'next/dynamic';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { stateParticipationData, demographicsData, trendData, phaseProgressData } from '@/data/dashboard-demo';
import { motion } from 'framer-motion';

// Dynamically import Recharts to avoid SSR hydration issues
const BarChart = dynamic(() => import('recharts').then(mod => mod.BarChart), { ssr: false });
const Bar = dynamic(() => import('recharts').then(mod => mod.Bar), { ssr: false });
const PieChart = dynamic(() => import('recharts').then(mod => mod.PieChart), { ssr: false });
const Pie = dynamic(() => import('recharts').then(mod => mod.Pie), { ssr: false });
const Cell = dynamic(() => import('recharts').then(mod => mod.Cell), { ssr: false });
const LineChart = dynamic(() => import('recharts').then(mod => mod.LineChart), { ssr: false });
const Line = dynamic(() => import('recharts').then(mod => mod.Line), { ssr: false });
const AreaChart = dynamic(() => import('recharts').then(mod => mod.AreaChart), { ssr: false });
const Area = dynamic(() => import('recharts').then(mod => mod.Area), { ssr: false });
const XAxis = dynamic(() => import('recharts').then(mod => mod.XAxis), { ssr: false });
const YAxis = dynamic(() => import('recharts').then(mod => mod.YAxis), { ssr: false });
const CartesianGrid = dynamic(() => import('recharts').then(mod => mod.CartesianGrid), { ssr: false });
const Tooltip = dynamic(() => import('recharts').then(mod => mod.Tooltip), { ssr: false });
const ResponsiveContainer = dynamic(() => import('recharts').then(mod => mod.ResponsiveContainer), { ssr: false });
const Legend = dynamic(() => import('recharts').then(mod => mod.Legend), { ssr: false });

const COLORS = ['#3b82f6', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6'];

export default function DashboardPage() {
  const t = useTranslations('dashboard');

  const renderDemoBadge = () => (
    <Badge variant="outline" className="bg-yellow-500/10 text-yellow-500 border-yellow-500/50 ml-2 shadow-sm font-semibold text-[10px] uppercase backdrop-blur-md">
      {t('demoDataBadge')}
    </Badge>
  );

  const containerVariants = {
    hidden: { opacity: 0 },
    visible: {
      opacity: 1,
      transition: {
        staggerChildren: 0.15
      }
    }
  };

  const itemVariants = {
    hidden: { y: 20, opacity: 0 },
    visible: {
      y: 0,
      opacity: 1,
      transition: { duration: 0.6, ease: "easeOut" }
    }
  };

  return (
    <div className="container mx-auto max-w-7xl py-24 px-4 md:px-6 min-h-screen relative">
      {/* Background Glow */}
      <div className="absolute top-1/4 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-[120px] pointer-events-none" />
      <div className="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-600/10 rounded-full blur-[120px] pointer-events-none" />

      <motion.div 
        initial={{ opacity: 0, y: -20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.6 }}
        className="mb-12 text-center"
      >
        <h1 className="text-4xl md:text-5xl font-extrabold tracking-tight glow-text mb-4">{t('title')}</h1>
        <p className="text-muted-foreground text-lg max-w-2xl mx-auto">Real-time demographic analytics and state-wise enumeration progress, visualized.</p>
      </motion.div>

      <motion.div 
        variants={containerVariants}
        initial="hidden"
        animate="visible"
        className="grid grid-cols-1 lg:grid-cols-2 gap-8 relative z-10"
      >
        {/* 1. Bar Chart - State-wise Participation */}
        <motion.div variants={itemVariants}>
          <Card className="glass-panel border-white/5 h-full hover:border-white/20 transition-colors duration-300">
            <CardHeader className="pb-2">
              <CardTitle className="flex items-center text-xl font-bold tracking-wide">
                {t('charts.participationTitle')} {renderDemoBadge()}
              </CardTitle>
              <CardDescription className="text-zinc-400">{t('charts.participationDesc')}</CardDescription>
            </CardHeader>
            <CardContent className="h-[350px] w-full mt-6">
              <ResponsiveContainer width="100%" height="100%">
                <BarChart data={stateParticipationData} margin={{ top: 5, right: 30, left: 20, bottom: 5 }}>
                  <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="rgba(255,255,255,0.1)" />
                  <XAxis dataKey="state" stroke="#a1a1aa" tick={{ fill: '#a1a1aa' }} />
                  <YAxis stroke="#a1a1aa" tick={{ fill: '#a1a1aa' }} />
                  <Tooltip 
                    contentStyle={{ backgroundColor: 'rgba(12, 12, 15, 0.8)', backdropFilter: 'blur(10px)', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '8px' }}
                    itemStyle={{ color: '#fff' }}
                  />
                  <Bar dataKey="percentage" fill="#3b82f6" radius={[6, 6, 0, 0]} />
                </BarChart>
              </ResponsiveContainer>
            </CardContent>
          </Card>
        </motion.div>

        {/* 2. Donut Chart - Demographic Breakdown */}
        <motion.div variants={itemVariants}>
          <Card className="glass-panel border-white/5 h-full hover:border-white/20 transition-colors duration-300">
            <CardHeader className="pb-2">
              <CardTitle className="flex items-center text-xl font-bold tracking-wide">
                {t('charts.demographicsTitle')} {renderDemoBadge()}
              </CardTitle>
              <CardDescription className="text-zinc-400">{t('charts.demographicsDesc')}</CardDescription>
            </CardHeader>
            <CardContent className="h-[350px] w-full mt-6">
              <ResponsiveContainer width="100%" height="100%">
                <PieChart>
                  <Pie
                    data={demographicsData}
                    cx="50%"
                    cy="50%"
                    innerRadius={70}
                    outerRadius={120}
                    paddingAngle={5}
                    dataKey="value"
                    nameKey="ageGroup"
                    label={{ fill: '#fff', fontSize: 12 }}
                  >
                    {demographicsData.map((entry, index) => (
                      <Cell key={`cell-${index}`} fill={COLORS[index % COLORS.length]} />
                    ))}
                  </Pie>
                  <Tooltip 
                    contentStyle={{ backgroundColor: 'rgba(12, 12, 15, 0.8)', backdropFilter: 'blur(10px)', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '8px' }}
                  />
                  <Legend wrapperStyle={{ paddingTop: '20px' }} />
                </PieChart>
              </ResponsiveContainer>
            </CardContent>
          </Card>
        </motion.div>

        {/* 3. Line Chart - Historical Trend */}
        <motion.div variants={itemVariants}>
          <Card className="glass-panel border-white/5 h-full hover:border-white/20 transition-colors duration-300">
            <CardHeader className="pb-2">
              <CardTitle className="flex items-center text-xl font-bold tracking-wide">
                {t('charts.trendTitle')} {renderDemoBadge()}
              </CardTitle>
              <CardDescription className="text-zinc-400">{t('charts.trendDesc')}</CardDescription>
            </CardHeader>
            <CardContent className="h-[350px] w-full mt-6">
              <ResponsiveContainer width="100%" height="100%">
                <LineChart data={trendData} margin={{ top: 5, right: 30, left: 20, bottom: 5 }}>
                  <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="rgba(255,255,255,0.1)" />
                  <XAxis dataKey="year" stroke="#a1a1aa" tick={{ fill: '#a1a1aa' }} />
                  <YAxis stroke="#a1a1aa" tick={{ fill: '#a1a1aa' }} />
                  <Tooltip 
                    contentStyle={{ backgroundColor: 'rgba(12, 12, 15, 0.8)', backdropFilter: 'blur(10px)', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '8px' }}
                  />
                  <Line type="monotone" dataKey="population" stroke="#ec4899" strokeWidth={4} dot={{ r: 5, fill: '#ec4899' }} activeDot={{ r: 8, strokeWidth: 0 }} />
                </LineChart>
              </ResponsiveContainer>
            </CardContent>
          </Card>
        </motion.div>

        {/* 4. Area Chart - Phase-wise Progress */}
        <motion.div variants={itemVariants}>
          <Card className="glass-panel border-white/5 h-full hover:border-white/20 transition-colors duration-300">
            <CardHeader className="pb-2">
              <CardTitle className="flex items-center text-xl font-bold tracking-wide">
                {t('charts.progressTitle')} {renderDemoBadge()}
              </CardTitle>
              <CardDescription className="text-zinc-400">{t('charts.progressDesc')}</CardDescription>
            </CardHeader>
            <CardContent className="h-[350px] w-full mt-6">
              <ResponsiveContainer width="100%" height="100%">
                <AreaChart data={phaseProgressData} margin={{ top: 5, right: 30, left: 20, bottom: 5 }}>
                  <CartesianGrid strokeDasharray="3 3" vertical={false} stroke="rgba(255,255,255,0.1)" />
                  <XAxis dataKey="phase" stroke="#a1a1aa" tick={{ fill: '#a1a1aa' }} />
                  <YAxis stroke="#a1a1aa" tick={{ fill: '#a1a1aa' }} />
                  <Tooltip 
                    contentStyle={{ backgroundColor: 'rgba(12, 12, 15, 0.8)', backdropFilter: 'blur(10px)', border: '1px solid rgba(255,255,255,0.1)', borderRadius: '8px' }}
                  />
                  <Area type="monotone" dataKey="completion" stroke="#10b981" strokeWidth={3} fill="#10b981" fillOpacity={0.2} />
                </AreaChart>
              </ResponsiveContainer>
            </CardContent>
          </Card>
        </motion.div>
      </motion.div>
    </div>
  );
}
